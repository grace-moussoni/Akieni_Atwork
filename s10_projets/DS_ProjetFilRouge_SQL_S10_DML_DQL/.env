# --- Configuration SQL Server ---
DB_SERVER=localhost\SQLEXPRESS
# Remplacez par le nom de votre base de données
DB_NAME=OlistCommerce

# --- Authentification & Sécurité (Identiques à la capture) ---
# Windows Authentication
DB_TRUSTED_CONNECTION=yes
# Encrypt: Mandatory
DB_ENCRYPT=yes
# Trust Server Certificate: Coché
DB_TRUST_SERVER_CERT=yes

# --- Configuration Application ---
APP_ENV=development
DEBUG=True
SEEDS_DIR=assets/seeds